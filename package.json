{
  "name": "mio-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-versions.mjs && node scripts/check-release.mjs && next build",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "test:versions": "node --test scripts/versioning.test.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "docs:version": "node scripts/create-docs-version.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.8",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "^1.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "^4.3.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/mdx": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "~5.9.3"
  }
}
